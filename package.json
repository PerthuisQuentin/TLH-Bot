{
  "name": "discord-getting-started",
  "private": true,
  "version": "1.0.0",
  "description": "Discord example app",
  "main": "dist/app.js",
  "type": "module",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:core": "npm run build && tsx scripts/check-core-purity.ts",
    "start": "node dist/app.js",
    "register": "tsx --env-file=.env.dev commands.ts",
    "register:prod": "tsx --env-file=.env.prod commands.ts",
    "register:local": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx --env-file=.env.dev commands.ts",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx watch --env-file=.env.dev app.ts",
    "dev:prod": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx watch --env-file=.env.prod app.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "author": "Shay DeWael",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@openrouter/sdk": "^1.2.120",
    "decimal.js": "^10.6.0",
    "discord-api-types": "^0.38.43",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.26.0",
    "express": "^5.2.1",
    "node-cache": "^5.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
